{
  "name": "prism",
  "private": true,
  "version": "0.1.0",
  "description": "Prism — an OpenAI-compatible LLM gateway with semantic cache, smart routing, and per-tenant metering.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:gateway": "pnpm --filter @prism/gateway dev",
    "dev:console": "pnpm --filter @prism/console dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
