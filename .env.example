# Copy to `.env` for local overrides. Every value below also has a default in
# docker-compose.yml, so `docker compose up` works without a .env file.
# Secrets belong here (or in the real environment) and are never committed.

# --- Gateway ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Token for the /admin/* routes (sent in the x-admin-token header). Change it.
ADMIN_TOKEN=change-me-demo-admin-token

# --- Upstream call timeouts (milliseconds) ---
# Must trip on a mock made slow with latency_ms: 3000, so keep the first-byte timeout below that.
UPSTREAM_TIMEOUT_MS=2000
UPSTREAM_IDLE_TIMEOUT_MS=2000
REQUEST_DEADLINE_MS=10000

# --- Postgres (pgvector) ---
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism
POSTGRES_DB=prism
POSTGRES_PORT=5432
DATABASE_URL=postgres://prism:prism@postgres:5432/prism
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000

# --- Configuration and seed data (files in DATA_DIR) ---
# Outside Docker the defaults are used: DATA_DIR=<repo>/data and the sample config
# (providers on localhost). Docker Compose sets DATA_DIR=/data and the docker config.
GATEWAY_CONFIG_FILE=gateway_config.docker.json
# Load data/seed_keys.json into Postgres on startup (idempotent). Set false to skip.
SEED_ON_START=true

# --- Redis (RPM sliding window) ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Host ports ---
GATEWAY_PORT=8080
CONSOLE_PORT=3000
ALPHA_PORT=9001
BETA_PORT=9002
