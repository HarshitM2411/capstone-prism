# Copy to `.env` for local overrides. Every value below also has a default in
# docker-compose.yml, so `docker compose up` works without a .env file.
# Secrets belong here (or in the real environment) and are never committed.

# --- Gateway ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Token for the /admin/* routes (sent in the x-admin-token header). Change it.
ADMIN_TOKEN=change-me-demo-admin-token

# --- Postgres (pgvector) ---
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism
POSTGRES_DB=prism
POSTGRES_PORT=5432
DATABASE_URL=postgres://prism:prism@postgres:5432/prism
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000

# --- Configuration and seed data (files in DATA_DIR) ---
# Outside Docker the defaults are used: DATA_DIR=<repo>/data and the sample config
# (providers on localhost). Docker Compose sets DATA_DIR=/data and the docker config.
GATEWAY_CONFIG_FILE=gateway_config.docker.json
# Load data/seed_keys.json into Postgres on startup (idempotent). Set false to skip.
SEED_ON_START=true

# --- Redis (RPM sliding window) ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
# Per-command timeout. If Redis does not answer in time the request is rejected with 503
# (the rate limiter fails closed). 50-10000 ms.
REDIS_TIMEOUT_MS=500

# --- Provider calls (timeouts at the adapter boundary) ---
# Time for a provider to start answering. Must trip on a mock made slow with latency_ms: 3000.
PROVIDER_FIRST_BYTE_TIMEOUT_MS=2000
# Streams: the longest silence tolerated between two chunks.
PROVIDER_IDLE_TIMEOUT_MS=10000
# Cap on the whole provider call, including every retry and failover attempt of one request.
REQUEST_DEADLINE_MS=10000
# Streams: the longest a single streamed response may last (must not be below the deadline above).
STREAM_MAX_DURATION_MS=120000

# --- Embeddings (auto routing now, semantic cache later) ---
# Local model; the Docker image ships with it baked in, so nothing is downloaded at runtime.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# One embedding may take this long; past it the router uses structural signals only.
EMBEDDING_TIMEOUT_MS=1500

# --- Semantic cache ---
# How long a cached answer is served (seconds). 0 = never expires. Expired entries are removed
# every minute; there is no size cap (known limitation).
CACHE_TTL_SECONDS=86400

# --- Host ports ---
GATEWAY_PORT=8080
CONSOLE_PORT=3000
ALPHA_PORT=9001
BETA_PORT=9002

# --- Real providers (optional, see docs/real-provider.md) ---
# Referenced from a gateway config as "api_key": "env:OPENAI_API_KEY". Never commit real keys.
# OPENAI_API_KEY=
# GROQ_API_KEY=
